<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\Mods\polis-builder-npc</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Hermetic: the game dir comes from .env (sourced by build.sh).
       VINTAGE_STORY must exist and contain VintagestoryAPI.dll. -->
  <PropertyGroup>
    <VintageStoryDir Condition="Exists('$(VINTAGE_STORY)/VintagestoryAPI.dll')">$(VINTAGE_STORY)</VintageStoryDir>
  </PropertyGroup>
  <Target Name="RequireGameDir" BeforeTargets="Build" Condition="'$(VintageStoryDir)' == ''">
    <Error Text="VINTAGE_STORY is not set or has no VintagestoryAPI.dll. Create .env (see .env.example) with VINTAGE_STORY=/path/to/vintagestory." />
  </Target>

  <ItemGroup>
    <Compile Remove="refs/**" />
    <None Remove="refs/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryDir)/VintagestoryAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VintagestoryLib"><HintPath>$(VintageStoryDir)/VintagestoryLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VintageStoryDir)/Mods/VSSurvivalMod.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryDir)/Mods/VSEssentials.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(VintageStoryDir)/Lib/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="protobuf-net"><HintPath>$(VintageStoryDir)/Lib/protobuf-net.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="cairo-sharp"><HintPath>$(VintageStoryDir)/Lib/cairo-sharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryDir)/Lib/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <!-- Screenshot capture dependencies (shipped with VS) -->
    <Reference Include="OpenTK.Graphics"><HintPath>$(VintageStoryDir)/Lib/OpenTK.Graphics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="OpenTK.Mathematics"><HintPath>$(VintageStoryDir)/Lib/OpenTK.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SkiaSharp"><HintPath>$(VintageStoryDir)/Lib/SkiaSharp.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Test UI for harness -->
  <ItemGroup>
    <Content Include="tools/test-ui.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>tools/test-ui.html</Link>
    </Content>
    <Content Include="tools/webui-v2/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
