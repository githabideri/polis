# .env for the polis repo (copy to .env; the live .env is gitignored).
#
# Everything is optional — every consumer has a sane default or a
# self-describing error — but on the game testbed the decision-loop group
# is what makes scripts/jev-loop-v5.py runnable as-is.
#
# Values are *roles*, not hosts: this repo is deployment-agnostic (see the
# README's sanitization rule). On a real deployment .env holds the concrete
# endpoints (which in this project are Tailscale addresses).

## Build & deploy (build.sh, scripts/check-env.sh)
# Game installation root; VSDATA holds user data (worlds, mods).
VINTAGE_STORY=/opt/vintagestory/extra/vintagestory
VSDATA=/root/.config/VintagestoryData

## Harness (in-game HTTP server, port 8585)
# LAN address the harness additionally binds to (web UI reachable without
# an ssh tunnel). Loopback-only if unset.
POLIS_HARNESS_IP=<polis-container-ip>

## CLI & mission runner (scripts/poliscli.py, scripts/polis-test-runner.py)
POLIS_HOST=127.0.0.1          # harness host (default 127.0.0.1)
POLIS_PORT=8585               # harness port (PolisConstants.DefaultPort)
# Player UIDs contain '+' — always URL-encode as %2B on the wire.
POLIS_PLAYER_UID=<your-player-uid>
POLIS_BOT_ID=<selected-bot-id>

## The v5 three-tier decision loop (scripts/jev-loop-v5.py)
# POLIS_DECIDER       the decider-2b service (the reflex model; the 3060 card here)
# POLIS_DECIDER_FAST  optional faster decider variant
# POLIS_PROMPT        prompt-render endpoint (the CPU batch box /prompt here)
# POLIS_OPENJEV_URL   the Laya 421M noul endpoint (the openjev service here)
# POLIS_LLM           the 27B doubt-arbiter (a vLLM box here)
POLIS_DECIDER=http://<3060-card>/prompt
POLIS_PROMPT=http://<cpu-batch-box>/prompt
POLIS_OPENJEV_URL=http://<openjev-service>
POLIS_LLM=http://<27b-vllm-box>/v1/chat/completions

## Model measurement (scripts/jevab/: A/B runs, fine-tuning, canaries)
POLIS_PROMPT_URL=http://<cpu-batch-box>/prompt   # prompt rendering
POLIS_CARD_URL=http://<3060-card>                # decider HTTP card service

## One-off probes (scripts/probe-material.py)
# POLIS_UID=<player-uid>   (no default on purpose — a real UID never ships)
